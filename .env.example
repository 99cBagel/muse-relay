# Copy to .env for local `wrangler dev` / deploy auth.
# CLOUDFLARE_API_TOKEN is used by wrangler for API-token deploys:
#   CLOUDFLARE_API_TOKEN=xxx wrangler deploy
CLOUDFLARE_API_TOKEN=

# Shared secret the processing backend sends as
# `Authorization: Bearer <secret>` on /mcp.
# Set in production with: wrangler secret put RELAY_SHARED_SECRET
RELAY_SHARED_SECRET=
